{
  "name": "react-iconfont-kit",
  "version": "1.0.0",
  "description": "Generate React / React Native / Mini Program / Taro icon components from iconfont.cn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "iconfont": "./dist/cli.js",
    "iconfont-kit": "./dist/cli.js",
    "iconfont-init": "./dist/bins/init.js",
    "iconfont-h5": "./dist/bins/h5.js",
    "iconfont-rn": "./dist/bins/rn.js",
    "iconfont-taro": "./dist/bins/taro.js",
    "iconfont-wechat": "./dist/bins/wechat.js",
    "iconfont-alipay": "./dist/bins/alipay.js",
    "iconfont-baidu": "./dist/bins/baidu.js",
    "iconfont-toutiao": "./dist/bins/toutiao.js",
    "iconfont-kuaishou": "./dist/bins/kuaishou.js",
    "iconfont-qq": "./dist/bins/qq.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qg-hs/react-iconfont-kit.git"
  },
  "bugs": {
    "url": "https://github.com/qg-hs/react-iconfont-kit/issues"
  },
  "homepage": "https://github.com/qg-hs/react-iconfont-kit#readme",
  "author": "qghs <1556448918@qq.com>",
  "engines": {
    "node": ">=20.18.0"
  },
  "keywords": [
    "iconfont",
    "react",
    "react-native",
    "taro",
    "mini-program",
    "wechat",
    "icon"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "fast-xml-parser": "^5.11.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
